{
  "name": "nextkid-storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "dev:worker": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run --config vitest.backend.config.ts",
    "test:sync": "wrangler deploy --dry-run --outdir .wrangler/test-dist && node scripts/test-sync.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project=storybook"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "latest",
    "@fontsource/barlow-condensed": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@storybook/addon-a11y": "latest",
    "@storybook/addon-vitest": "latest",
    "@storybook/react-vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitest/browser-playwright": "^4.0.0",
    "jsdom": "latest",
    "miniflare": "5.20260910.0-alpha",
    "playwright": "latest",
    "storybook": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.0.0",
    "wrangler": "^4.131.0"
  },
  "packageManager": "pnpm@10.17.1"
}
